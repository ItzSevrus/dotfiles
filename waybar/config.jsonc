
{
    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 0,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        "hyprland/workspaces",
        "wlr/taskbar"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "network",
        "custom/bluetooth",
        "backlight",
        "pulseaudio",
        "battery"
    ],
    
    "wlr/taskbar": {
	    "format": "{icon}",
	    "icon-size": 32,
	    "tooltip-format": "{title}",
	    "on-click": "activate",
	    "on-click-middle": "close",
	    "ignore-list": [],
	    "rewrite": {}
	},

    "hyprland/workspaces": {
        "format": "{name}",
        "disable-scroll": true,
        "all-outputs": false,
        "on-click": "activate"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 36,
        "separate-outputs": true,
        "rewrite": {
            "(.*)Mozilla Firefox(.*)": "Firefox",
            "(.*) - Visual Studio Code": "Code"
        }
    },
    
	"clock": {
	    "interval": 30,
	    "format": "  {:%I:%M %p  |    %d %b}",
	    "tooltip": true,
	    "tooltip-format": "{:%A, %d %B %Y}",
	    "format-alt": "{:%A, %d %B %Y}",
	    "on-click-right": "gnome-calendar"
	},

	"network": {
	    "interval": 5,
	    "format-wifi": "",
	    "format-ethernet": "󰈀  Ethernet",
	    "format-disconnected": "󰤭  Offline",
	    "tooltip-format-wifi": "Network: {essid}\nSignal: {signalStrength}%",
	    "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}",
	    "tooltip-format-disconnected": "Not connected",
	    "on-click": "nm-connection-editor"
	},

	"pulseaudio": {
	    "format": "{icon}  {volume}%",
	    "format-muted": "󰝟  Muted",
	    "format-icons": {
		"headphone": "󰋋",
		"headset": "󰋎",
		"default": [
		    "󰕿",
		    "󰖀",
		    "󰕾"
		]
	    },
	    "scroll-step": 5,
	    "on-click": "pavucontrol",
	    "on-click-right": "helvum"
	},

    "custom/bluetooth": {
        "exec": "~/.config/waybar/scripts/bluetooth-status.sh",
        "return-type": "json",
        "interval": 3,
        "format": "{}",
        "tooltip": true,
        "on-click": "blueman-manager"
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "tooltip": true,
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-discharging": "{icon}  {capacity}%",
        "format-charging": "󰂄  Charging {capacity}%",
        "format-plugged": "󰚥  Plugged in {capacity}%",
        "format-full": "󰁹  Fully charged",
        "format-alt": "{icon}  {time} remaining",
        "format-icons": [
            "󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾",
            "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
        ],
        "tooltip": true
    }
}
